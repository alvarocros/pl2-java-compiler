                EST.SuMa := esT.SumA - (0 - LImIt);
                eST.MUlT := est.MulT * lIMiT;
                lIMit := LimIT - 1;
            enD LoOP;
        EnD iNIciALIZaR;
    beGIn
        INICiALIzaR(numerOS.UNo, 1);
